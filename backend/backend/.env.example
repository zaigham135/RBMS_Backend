# Spring Profile Configuration
# Use 'dev' for local development (Redis sessions)
# Use 'prod' for production deployment (DynamoDB sessions)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5433/task_management
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# Redis Configuration (for local development)
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS Configuration (for production with DynamoDB)
AWS_REGION=us-east-1
SESSION_TIMEOUT=1800

# Email Configuration (Gmail SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Google Calendar (Optional)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CREDENTIALS_FILE=/path/to/google-credentials.json
